# ─── Email Notifications ─────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
#
# Gmail setup:
#   1. Go to myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Search "App passwords" → create one for "EasyMove"
#   4. Use that 16-char password below (not your real Gmail password)

GMAIL_USER=etbcompanyllc24@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Where to send lead notifications (defaults to romanov@easy-move-florida.com if not set)
# NOTIFY_EMAIL=romanov@easy-move-florida.com


# ─── Telegram Notifications (optional) ───────────────────────────────────────
# To set up:
#   1. Message @BotFather on Telegram → /newbot → copy the token
#   2. Start a conversation with your bot
#   3. Visit: https://api.telegram.org/bot<TOKEN>/getUpdates
#      to find your chat_id (look for "chat":{"id": XXXXXXX})

# TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
# TELEGRAM_CHAT_ID=123456789


# ─── Twilio SMS (optional) ────────────────────────────────────────────────────
# Sends an SMS confirmation to the customer after a quote or contact form submission.
# If any variable is missing, SMS is skipped silently (app still works).
#
# To set up:
#   1. Log in to console.twilio.com
#   2. Account SID and Auth Token are on the Account Info panel (SID starts with AC)
#   3. Use your Twilio phone number in E.164 format: +17869779993

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+17869779993


# ─── Analytics ───────────────────────────────────────────────────────────────
# Microsoft Clarity — session recordings & heatmaps (free)
# To set up: go to clarity.microsoft.com → New project → copy the tracking ID
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# ─── Admin login (/admin) ────────────────────────────────────────────────────
# Required. Credentials used to be hardcoded in src/lib/auth.ts; they now come
# from here. With either value unset, admin login is refused.
# Set the same pair in Vercel → Project → Settings → Environment Variables.
ADMIN_EMAIL=admin@easy-move-florida.com
ADMIN_PASSWORD=change-me-to-something-long-and-random
# ADMIN_NAME=Evgenii
