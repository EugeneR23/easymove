# ─── Email Notifications ─────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
#
# Gmail setup:
#   1. Go to myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Search "App passwords" → create one for "EasyMove"
#   4. Use that 16-char password below (not your real Gmail password)

GMAIL_USER=etbcompanyllc24@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Where to send lead notifications (defaults to etbcompanyllc24@gmail.com if not set)
# NOTIFY_EMAIL=etbcompanyllc24@gmail.com


# ─── Telegram Notifications (optional) ───────────────────────────────────────
# To set up:
#   1. Message @BotFather on Telegram → /newbot → copy the token
#   2. Start a conversation with your bot
#   3. Visit: https://api.telegram.org/bot<TOKEN>/getUpdates
#      to find your chat_id (look for "chat":{"id": XXXXXXX})

# TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
# TELEGRAM_CHAT_ID=123456789
