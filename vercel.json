{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)docs' ':(exclude)*.md'",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "easy-move-florida.com" }],
      "destination": "https://www.easy-move-florida.com/$1",
      "permanent": true
    }
  ]
}
